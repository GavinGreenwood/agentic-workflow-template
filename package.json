{
  "name": "@template/monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration --continue",
    "test:e2e": "playwright test --pass-with-no-tests",
    "verify:agents": "node scripts/verify-agent-workflow.mjs",
    "clean": "turbo clean",
    "prepare": "husky && bash scripts/setup-links.sh",
    "verify:codex-hooks": "node scripts/check-codex-hook-trust.mjs"
  },
  "overrides": {
    "tmp": "0.2.7",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.4",
    "lodash": "4.18.1",
    "brace-expansion": "5.0.11",
    "fast-uri@3": "3.1.7",
    "js-yaml@4": "4.3.2",
    "js-yaml@5": "5.2.2",
    "postcss@8": "8.5.24",
    "sharp": "0.35.5",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "turbo": "^2.11.8",
    "typescript": "^5.8.0"
  }
}
