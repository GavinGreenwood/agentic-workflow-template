{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash|shell|execute|Write|write|Edit|edit|create|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pre-tool-use.js copilot"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/stop-docs-sync.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|write|Edit|edit|create|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/post-tool-use.sh"
          }
        ]
      }
    ]
  }
}
