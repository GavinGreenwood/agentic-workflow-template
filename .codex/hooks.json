{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|Write|Edit|exec_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pre-tool-use.js codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/stop-docs-sync.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/post-tool-use.sh"
          }
        ]
      }
    ]
  }
}
